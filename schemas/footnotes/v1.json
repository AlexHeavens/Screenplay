{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screenplay.invalid/schemas/footnotes/v1.json",
  "title": "Footnotes (footnotes.json), version 1",
  "description": "A missing or unreadable file means none. No version field: the root is an array.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "anchor",
      "text"
    ],
    "additionalProperties": true,
    "properties": {
      "anchor": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "contents": {
        "type": "boolean",
        "description": "Written only when true. Default false."
      }
    }
  }
}
